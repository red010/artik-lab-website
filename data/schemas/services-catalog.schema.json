{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ar-tik.com/data/schemas/services-catalog.schema.json",
  "title": "Artik Lab services catalog",
  "type": "object",
  "required": [
    "generatedAt",
    "locale",
    "language",
    "services"
  ],
  "properties": {
    "generatedAt": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
